# ─────────────────────────────────────────────────────────────────────
# MiniMax Anthropic demo — environment template
#
# Copy this file to `.env` and fill in real values before running:
#   cp .env.example .env
# `docker compose` automatically reads `.env` from this directory,
# and the Python app loads it via python-dotenv on startup.
#
# Everything below is gitignored once it lives in `.env`.
# ─────────────────────────────────────────────────────────────────────

# Anthropic-compatible endpoint provided by MiniMax
ANTHROPIC_BASE_URL=https://api.minimax.cn/anthropic

# Your MiniMax subscription key.
# Get it from https://platform.minimax.cn/user-center/basic-information
ANTHROPIC_API_KEY=YOUR_API_KEY_HERE

# Default model (see docs for the full supported list)
MINIMAX_MODEL=MiniMax-M3

# Max output tokens for the /hello endpoint
MAX_TOKENS=1000

# Host port that docker-compose publishes for the app (container always 8000)
APP_PORT=8000

# ─── MongoDB (used by docker-compose) ───────────────────────────────
# These values are also baked into the Mongo connection URI used by the app.
MONGO_USER=minimax_admin
MONGO_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD
MONGO_DB=minimax_demo
MONGO_COLLECTION=conversations