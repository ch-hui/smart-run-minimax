# ─────────────────────────────────────────────────────────────────────
# MiniMax Anthropic demo — environment template
#
# Copy this file to `.env` and fill in real values before running:
#   cp .env.example .env
# `docker compose` automatically reads `.env` from this directory,
# and the Python app loads it via python-dotenv on startup.
#
# Everything below is gitignored once it lives in `.env`.
# ─────────────────────────────────────────────────────────────────────

# Anthropic-compatible endpoint provided by MiniMax
ANTHROPIC_BASE_URL=https://api.minimax.cn/anthropic

# Your MiniMax subscription key.
# Get it from https://platform.minimax.cn/user-center/basic-information
ANTHROPIC_API_KEY=YOUR_API_KEY_HERE

# Default model (see docs for the full supported list)
MINIMAX_MODEL=MiniMax-M3

# Max output tokens for the /hello endpoint
MAX_TOKENS=1000

# Host port that docker-compose publishes for the app (container always 8000)
APP_PORT=8000

# Host port that docker-compose publishes for MongoDB (container always 27017).
# Change this if 27017 is already taken on the host.
MONGO_HOST_PORT=27017

# When running the app OUTSIDE of docker-compose (e.g. local python -m uvicorn
# or a tests/ probe), point MONGO_URL at the deployed/remote instance.
# Inside docker-compose, MONGO_URL is set automatically to mongo:27017 using
# the same MONGO_USER / MONGO_PASS below.
# Example:
#   MONGO_URL=mongodb://minimax_admin:YOUR_PASS@47.121.29.106:27017/minimax_demo?authSource=admin
# MONGO_URL=

# ─── Web search (grounds /race/batch answers in real data) ─────────────
# Set WEB_SEARCH_ENABLED=false to fall back to model-only mode (legacy).
WEB_SEARCH_ENABLED=true

# Optional: get a free key at https://tavily.com (1000 searches/month free)
# When set, Tavily is preferred over the DuckDuckGo HTML fallback.
# TAVILY_API_KEY=

# Per-request timeout (seconds) and TTL cache for repeated race_name queries.
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_CACHE_TTL=1800

# ─── MongoDB (used by docker-compose) ───────────────────────────────
# These values are also baked into the Mongo connection URI used by the app.
MONGO_USER=minimax_admin
MONGO_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD
MONGO_DB=minimax_demo
MONGO_COLLECTION=conversations